# ==============================================================================
# MetaSphere Enterprise Data Catalog - Local Development Environment Template
# ==============================================================================
# Copy this template to .env for local development:
#   cp .env.example .env
#
# DO NOT commit real secrets or production credentials to version control.
# Real .env files are strictly ignored by .gitignore.
# ==============================================================================

# Application Metadata & Runtime
APP_NAME="MetaSphere Enterprise Data Catalog"
APP_ENV=development
# Set DEBUG=True only on a developer machine (enables /docs and /openapi.json)
DEBUG=False
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Allowed CORS Origins (JSON array of strings)
CORS_ORIGINS=["http://localhost:4200"]

# PostgreSQL Central Repository (Docker Compose defaults)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=metasphere
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_local_dev

# Process Role & Connection Pool Tuning (api = 10, celery = 5)
PROCESS_ROLE=api
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=2.0
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=2
DB_STATEMENT_TIMEOUT_MS=2000

# Redis Background Task Broker & Cache (Docker Compose defaults)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_SOCKET_TIMEOUT=2.0
REDIS_CONNECT_TIMEOUT=2.0

# Celery Broker & Backend (Defaults to redis://{REDIS_HOST}:{REDIS_PORT}/{REDIS_DB})
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
