{
  "openapi": "3.1.0",
  "info": {
    "title": "MetaSphere Project Foundation - Health API",
    "description": "Liveness and Readiness observability probes for the MetaSphere Enterprise Data Catalog backend.",
    "version": "0.1.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Process Liveness Probe",
        "description": "Returns HTTP 200 if the FastAPI application process is up and capable of receiving HTTP traffic. Does not probe downstream dependencies.",
        "operationId": "checkLiveness",
        "responses": {
          "200": {
            "description": "Process is alive and responsive.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthLiveResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Dependency Readiness Probe",
        "description": "Validates active connections to the central PostgreSQL database and Redis background broker. Returns HTTP 200 when all monitored dependencies are operational, or HTTP 503 if any dependency fails.",
        "operationId": "checkReadiness",
        "responses": {
          "200": {
            "description": "All dependencies are connected and ready.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReadyResponse"
                }
              }
            }
          },
          "503": {
            "description": "One or more dependencies are unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReadyResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthLiveResponse": {
        "type": "object",
        "required": ["status", "timestamp", "service", "version"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["live"],
            "example": "live"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-02T12:00:00Z"
          },
          "service": {
            "type": "string",
            "example": "metasphere-backend"
          },
          "version": {
            "type": "string",
            "example": "0.1.0"
          }
        }
      },
      "ComponentStatus": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": {
            "type": "string",
            "example": "postgres"
          },
          "status": {
            "type": "string",
            "enum": ["connected", "disconnected", "error"],
            "example": "connected"
          },
          "latency_ms": {
            "type": ["number", "null"],
            "minimum": 0.0,
            "example": 1.45
          },
          "error": {
            "type": ["string", "null"],
            "example": null
          }
        }
      },
      "HealthReadyResponse": {
        "type": "object",
        "required": ["status", "timestamp", "components"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ready", "unhealthy"],
            "example": "ready"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-02T12:00:00Z"
          },
          "components": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/ComponentStatus"
            },
            "example": {
              "postgres": {
                "name": "postgres",
                "status": "connected",
                "latency_ms": 1.45,
                "error": null
              },
              "redis": {
                "name": "redis",
                "status": "connected",
                "latency_ms": 0.85,
                "error": null
              }
            }
          }
        }
      }
    }
  }
}

